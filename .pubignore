# Files kept out of the published archive.
#
# `.pubignore` REPLACES `.gitignore` for this directory when publishing, so
# everything that must stay out of the package is listed here, not only the
# paths that git also ignores.

# Not the package's `doc/` folder: design specs and implementation plans that
# are tracked in git but of no use to a consumer of the package.
/docs/

# Working directories of the agent tooling, and the instructions they read.
/.claude/
/.superpowers/
/AGENTS.md
/CLAUDE.md

# The repository's own process, not the package: editor settings and CI.
/.vscode/
/.github/

# Platform folders of the examples: 88 files and ~690 KB of `flutter create`
# output, the largest block of the archive once `docs/` is out. A reader of an
# example needs its Dart; `flutter create .` regenerates the rest.
/example/*/macos/
/example/scopo_demo/web/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per
# https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/

# FVM Version Cache
.fvm/
.fvmrc
